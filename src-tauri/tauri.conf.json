{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Reality Launcher",
    "version": "4.2.0",
    "identifier": "net.catlab.reality-launcher",
    "build": {
        "beforeDevCommand": "bun dev",
        "devUrl": "http://localhost:5173",
        "beforeBuildCommand": "bun run build",
        "frontendDist": "../dist"
    },
    "app": {
        "withGlobalTauri": true,
        "windows": [
            {
                "title": "Reality Launcher",
                "width": 360,
                "height": 380,
                "resizable": false,
                "center": true,
                "fullscreen": false,
                "decorations": false,
                "backgroundColor": "#09090b"
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ]
    }
}